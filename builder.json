{
    "name": "opal",
    "exclude": ["third-party/benchmark"],
    "options": {
        "benchmarks": {
            "type": "bool",
            "default": false,
            "description": "Build opal_benchmark, which fetches Google Benchmark"
        }
    },
    "dependencies": {
        "benchmark": {
            "url": "https://github.com/google/benchmark/archive/refs/tags/v1.9.5.tar.gz",
            "sha256": "9631341c82bac4a288bef951f8b26b41f69021794184ece969f8473977eaa340",
            "rules": "third-party/benchmark/benchmark.rules.cpp",
            "if": "benchmarks"
        }
    }
}
